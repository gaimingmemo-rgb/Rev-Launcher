/* REV-LAUNCHER NOIR & TACTICAL CRIMSON THEME */

QMainWindow {
    background-color: #08090c;
    color: #e0e6ed;
}

QWidget {
    font-family: 'Segoe UI', 'Consolas', 'Roboto', sans-serif;
    color: #e0e6ed;
}

/* Custom Title Bar */
#LauncherTitleBar {
    background-color: #0d1017;
    border-bottom: 2px solid #8a0e1c;
    min-height: 42px;
    max-height: 42px;
}

#TitleBarLabel {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 3px;
    color: #ffffff;
    text-transform: uppercase;
    padding-left: 6px;
}

#MeshStatusBadge {
    background-color: #101c18;
    border: 1px solid #00ff88;
    color: #00ff88;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 3px;
    letter-spacing: 1px;
}

/* Navigation Tab Bar */
#LauncherNavContainer {
    background-color: #0a0d13;
    border-bottom: 1px solid #1c2230;
    padding: 6px 16px;
}

.NavTabBtn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #8b949e;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 8px 14px;
    margin-right: 6px;
}

.NavTabBtn:hover {
    color: #ffffff;
    border-bottom: 2px solid #ff1e38;
}

.NavTabBtn[active="true"] {
    color: #ffffff;
    border-bottom: 2px solid #ff1e38;
    background: rgba(255, 30, 56, 0.08);
}

/* Search Bar */
#LauncherSearchBar {
    background-color: #0e1219;
    border: 1px solid #232a3a;
    border-radius: 4px;
    color: #ffffff;
    font-size: 12px;
    padding: 8px 14px;
    min-height: 20px;
}

#LauncherSearchBar:focus {
    border-color: #ff1e38;
}

/* Filter Buttons */
.FilterChip {
    background-color: #121722;
    border: 1px solid #232c3d;
    color: #9aa5b8;
    font-size: 10px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 3px;
    text-transform: uppercase;
}

.FilterChip:hover {
    border-color: #ff1e38;
    color: #ffffff;
}

.FilterChip[active="true"] {
    background-color: #ff1e38;
    border-color: #ff1e38;
    color: #ffffff;
}

/* Game Card */
.GameCard {
    background-color: #11151e;
    border: 1px solid #1e2533;
    border-radius: 6px;
    padding: 16px;
}

.GameCard:hover {
    border-color: #ff1e38;
    background-color: #151b27;
}

.GameCardTitle {
    font-size: 13px;
    font-weight: 800;
    color: #ffffff;
}

.GameCardMeta {
    font-size: 10px;
    color: #8b949e;
}

.GameCardBadge {
    background-color: #161e2c;
    border: 1px solid #2a3547;
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 9px;
    color: #00f0ff;
    font-weight: bold;
}

/* Primary Crimson Button */
.BtnPrimary {
    background-color: #ff1e38;
    border: 1px solid #ff1e38;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 7px 14px;
    border-radius: 4px;
    text-transform: uppercase;
}

.BtnPrimary:hover {
    background-color: #ff3850;
    border-color: #ffffff;
}

/* Secondary Button */
.BtnSecondary {
    background-color: #141a24;
    border: 1px solid #2b3548;
    color: #c9d1d9;
    font-size: 11px;
    font-weight: 700;
    padding: 7px 14px;
    border-radius: 4px;
    text-transform: uppercase;
}

.BtnSecondary:hover {
    border-color: #ff1e38;
    color: #ffffff;
}

/* Action Hub Buttons */
#WebsiteHubBtn {
    background: #0a1f24;
    border: 1px solid #00f0ff;
    color: #00f0ff;
    font-size: 10px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 3px;
}

#WebsiteHubBtn:hover {
    background: #00f0ff;
    color: #050b10;
}

#DiscordHubBtn {
    background: #151938;
    border: 1px solid #5865F2;
    color: #a4afff;
    font-size: 10px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 3px;
}

#DiscordHubBtn:hover {
    background: #5865F2;
    color: #ffffff;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #080a0e;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #252d3d;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #ff1e38;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
